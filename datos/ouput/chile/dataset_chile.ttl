<https://archivospatrimoniales.uc.cl///handle/123456789/61944> a schema:CreativeWork,
        schema:VideoObject ;
    schema:abstract "Fragmentos de Congreso Internacional de Literatura Femenina Latinoamericana, que se llevó a cabo en Santiago de Chile el 17 de agosto de 1987. Incluyó en su programa una serie de mesas de discusión sobre crítica literaria y teoría feminista, literatura y patriarcado, estrategias del discurso femenino, poesía y narrativa latinoamericana, además de recitales poéticos y encuentros con escritoras de diferentes latitudes. Aparecen: Eliana Ortega (escritora chilena), Ida Vitalle (poeta uruguaya), Lucia Guerra (crítica chilena), Diamela Eltit (escritora chilena), Nelly Richard (crítica chilena), José Donoso (escritor chileno), María Maluenda (actriz chilena), Jorge Edwards (escritor chileno), Beatriz Sarlo (crítica argentina), Antoinette Fouque (editora francesa), Eugenia Brito (crítica chilena), y Josefina Lubner (crítica argentina)." ;
    schema:additionalType "Video" ;
    schema:dateCreated "1987-08-17" ;
    schema:datePublished "2023-04-28T21:11:13Z" ;
    schema:encodingFormat "video/mp4" ;
    schema:isPartOf <https://example.org/dataset/eltit> ;
    schema:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    schema:name "Congreso Internacional de Literatura Femenina Latinoamericana" .

